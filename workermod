-- // Ustawienia
local Depth = getgenv().Depth or 160
local SellTreshold = getgenv().SellTreshold or 30000
local HeightOffset = 1.5 -- O ile wyżej ma teleportować (ciut wyżej niż oryginał)
local TravelSpeed = 2 -- Czas trwania płynnej teleportacji w sekundach

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- // Funkcja Płynnej Teleportacji
local function SmoothTeleport(targetCFrame, duration)
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
        
        hrp.Anchored = true
        tween:Play()
        tween.Completed:Wait()
        hrp.Anchored = false
    end
end

-- // Inicjalizacja Gry
repeat wait() until game:IsLoaded()
local gui = lp.PlayerGui:WaitForChild("ScreenGui")

while gui.LoadingFrame.BackgroundTransparency == 0 do
    for i, v in pairs(getconnections(gui.LoadingFrame.Quality.LowQuality.MouseButton1Down)) do
        v:Fire()
    end
    wait()
end

-- Czekanie na załadowanie statystyk
while true do
    if pcall(function() lp.leaderstats:WaitForChild("Blocks Mined") end) and 
       pcall(function() gui.StatsFrame.Coins:FindFirstChild("Amount") end) and 
       gui.StatsFrame.Tokens.Amount.Text ~= "Loading..." then
        break
    end
    wait(1)
end

-- Czyszczenie UI
gui.TeleporterFrame:Destroy()
gui.StatsFrame.Sell:Destroy()
gui.MainButtons.Surface:Destroy()

-- Anti-AFK
local vuAF = game:GetService("VirtualUser")
lp.Idled:Connect(function()
    vuAF:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    wait(1)
    vuAF:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- Re-join przy błędzie mapy
workspace.Collapsed.Changed:Connect(function()
    if workspace.Collapsed.Value == true then
        game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
    end
end)

-- Pobieranie RemoteEventu
local Remote
do
    local Data = getsenv(gui.ClientScript).displayCurrent
    local Values = getupvalue(Data, 8)
    Remote = Values["RemoteEvent"]
end

-- Pierwszy ruch (Płynny)
local function InitialMove()
    local hrp = lp.Character.HumanoidRootPart
    lp.Character.Humanoid.WalkSpeed = 0
    lp.Character.Humanoid.JumpPower = 0
    
    Remote:FireServer("MoveTo", {{"LavaSpawn"}})
    
    local part = Instance.new("Part", workspace)
    part.Anchored = true
    part.Size = Vector3.new(10, 0.5, 100)
    part.Material = "ForceField"
    part.Position = Vector3.new(21, 9.5, 26285)
    
    wait(1)
    -- Płynny przelot zamiast pętli while
    SmoothTeleport(CFrame.new(18, 10 + HeightOffset, 26220), TravelSpeed)
end

InitialMove()

-- Funkcje pomocnicze
local function GetInventoryAmount()
    local Amount = gui.StatsFrame2.Inventory.Amount.Text:gsub('%s+', ''):gsub(',', '')
    return tonumber(Amount:split("/")[1]) or 0
end

local function GetCoinsAmount()
    return tonumber(tostring(lp.leaderstats.Coins.Value):gsub(',', '')) or 0
end

-- Kopanie do określonej głębokości
local function MineToDepth()
    local hrp = lp.Character.HumanoidRootPart
    while true do
        local depthText = gui.TopInfoFrame.Depth.Text:split(" ")
        if tonumber(depthText[1]) >= Depth then break end
        
        local region = Region3.new(hrp.Position + Vector3.new(-1,-10,-1), hrp.Position + Vector3.new(1,0,1))
        local parts = workspace:FindPartsInRegion3WithWhiteList(region, {workspace.Blocks}, 5)
        for _, block in pairs(parts) do
            Remote:FireServer("MineBlock", {{block.Parent}})
            RunService.Stepped:Wait()
        end
        wait(0.1)
    end
end

MineToDepth()

-- Auto-Rebirth
local RebirthsAmount = lp.leaderstats.Rebirths
RunService:BindToRenderStep("Rebirth", 200, function()
    if GetCoinsAmount() >= (10000000 * (RebirthsAmount.Value + 1)) then
        Remote:FireServer("Rebirth", {{}})
    end
end)

-- Główna pętla kopania i sprzedaży
local recovering = false
local SellArea = CFrame.new(41.9, 10.8 + HeightOffset, -1239.6)

while true do
    local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp and not recovering then
        -- Kopanie w okolicy
        local region = Region3.new(hrp.Position - Vector3.new(10,10,10), hrp.Position + Vector3.new(10,10,10))
        local parts = workspace:FindPartsInRegion3WithWhiteList(region, {workspace.Blocks}, 100)
        
        for _, block in pairs(parts) do
            if block:IsA("BasePart") then
                Remote:FireServer("MineBlock", {{block.Parent}})
                RunService.Stepped:Wait()
            end
            
            -- Sprawdzanie Inventory
            if GetInventoryAmount() >= SellTreshold then
                local SavedPos = hrp.Position
                
                -- Płynna sprzedaż
                SmoothTeleport(SellArea, 1)
                while GetInventoryAmount() >= SellTreshold do
                    Remote:FireServer("SellItems", {{}})
                    wait(0.5)
                end
                
                -- Płynny powrót
                SmoothTeleport(CFrame.new(18, SavedPos.Y + HeightOffset, 26220), 1)
            end
        end
    end
    RunService.Stepped:Wait()
end
